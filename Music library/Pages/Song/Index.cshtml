@page
@model IndexModel
@{
    ViewData["Song"] = "Song page";
}

<div class="container mt-4">
    <h2>Song Overzicht</h2>

    @if (!Model.Songs.Any())
    {
        <p>Er zijn nog geen songs gevonden.</p>
    }
    else
    {
        <a asp-page="/Song/Create" class="btn btn-primary mb-3">
            Create New Song
        </a>
        <table class="table table-striped table-bordered mt-3">
            <thead class="table-dark">
                <tr>
                    <th>Id</th>
                    <th>Artist Id</th>
                    <th>Title</th>
                    <th>Genre</th>
                    <th>Duration (seconds)</th>
                    <th>Image</th>
                    <th>File</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var song in Model.Songs)
                {
                    <tr>
                        <td>@song.Id</td>
                        <td>@song.ArtistId</td>
                        <td>@song.Title</td>
                        <td>@song.Genre</td>
                        <td>@song.DurationInSeconds</td>
                        <td>@song.Image</td>
                        <td>@song.File</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>