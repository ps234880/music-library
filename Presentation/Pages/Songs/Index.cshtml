@page
@using Presentation.Pages.Songs
@model IndexModel

<div class="container mt-4">
    <h2>Song Overzicht</h2>

    @if (!Model.Songs.Any())
    {
        <p>Er zijn nog geen songs gevonden.</p>
    }
    else
    {
        <a asp-page="/Songs/Create" class="btn btn-primary mb-3">
            Add new song
        </a>
        <table class="table table-striped table-bordered mt-3">
            <thead class="table-dark">
                <tr>
                    <th>Id</th>
                    <th>Artist Name</th>
                    <th>Title</th>
                    <th>Genre</th>
                    <th>Duration (seconds)</th>
                    <th>Image</th>
                    <th>File</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var song in Model.Songs)
                {
                    <tr>
                        <td>@song.Id</td>
                        <td>@song.ArtistName</td>
                        <td>@song.Title</td>
                        <td>@song.Genre</td>
                        <td>
                            @TimeSpan.FromSeconds(song.DurationInSeconds).ToString(@"m\:ss")
                        </td>
                        <td>@song.Image</td>
                        <td>@song.File</td>
                        <td>
                            <div class="d-flex gap-2">

                                <a asp-page="./Update"
                                   asp-route-id="@song.Id"
                                   class="btn btn-warning btn-sm">
                                    Update
                                </a>

                                <form method="post"
                                      asp-page-handler="Delete"
                                      asp-route-id="@song.Id"
                                      onsubmit="return confirm('Are you sure you want to delete this song?');">

                                    <button type="submit" class="btn btn-danger btn-sm">
                                        Delete
                                    </button>

                                </form>

                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>