@page
@using Presentation.Pages.Artists
@model CreateModel

@{
    ViewData["Title"] = "Create artist";
}

<h2>Create artist</h2>

<form method="post">
    <div class="card-body">
        <div class="row g-3">

            <div class="col-md-6">
                <label asp-for="Artist.Name" class="form-label"></label>
                <input asp-for="Artist.Name" class="form-control bg-light text-dark border-secondary" />
                <span asp-validation-for="Artist.Name" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Artist.Description" class="form-label"></label>
                <input asp-for="Artist.Description" class="form-control bg-light text-dark border-secondary" />
                <span asp-validation-for="Artist.Description" class="text-danger"></span>
            </div>

        </div>
    </div>

    <div class="d-flex justify-content-end gap-3">
        <a asp-page="./Index" class="btn btn-outline-secondary">Annuleren</a>
        <button type="submit" class="btn btn-primary px-4">Opslaan</button>
    </div>
</form>